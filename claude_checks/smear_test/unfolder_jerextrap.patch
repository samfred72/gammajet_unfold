 #include "insitu_utility.h"
 using namespace std;
 
+// TRIAL (claude_checks/smear_test, branch jerextrap): GAMMAJET_JER_EXTRAP=lin15|lin5|tmpl|calib re-smears the MC
+// jet_pt_smear_truth with the nominal JER width extrapolated differently at low pT, as in
+// claude_checks/smear_test/fill_jet12_extrap.C:
+//   lin15  template above 15 GeV, its tangent at 15 GeV below
+//   lin5   template above its first bin centre c1 (5.19 GeV), its first segment continued below
+//   tmpl   the template itself (reproduces the stored smear; same bookkeeping as the others)
+//   calib  no extra smearing (jet pT = pt_calib)
+// The treemaker smeared with Gaus(pt_calib, pt_ref * w(pt_ref)) (CaloAna.cc smear_pt), pt_ref = matched truth
+// pT, or pt_calib if unmatched; only reco jets with pt_calib >= 5 GeV are matched (CaloAna.cc:316). Neither
+// the deviate nor pt_ref is stored, so: pt_ref = pt_calib below 5 GeV (exact); above, the stored leading truth
+// recoil jet if within 0.75R of the reco jet, else pt_calib (approximation, counted). The deviate is
+// recovered as z = (smear - calib) / (pt_ref w_tmpl(pt_ref)) and reused with the new width.
+namespace {
+  int jerExtrapMode() {
+    static int m = [] { const char * e = getenv("GAMMAJET_JER_EXTRAP"); if (!e) return 0;
+                        string s = e; return s == "lin15" ? 1 : s == "lin5" ? 2 : s == "tmpl" ? 3 : s == "calib" ? 4 : 0; }();
+    return m;
+  }
+  TH1D * jerNominal() {
+    static TH1D * h = [] {
+      TDirectory * saved = gDirectory;
+      TFile f(ana::path("claude_checks/smear_test/jerband_smearing_templates.root"), "read");
+      TH1D * x = (TH1D*)f.Get("h_jer_smear_r04_pileup_EMfracJES_nominal");
+      x->SetDirectory(0);
+      saved->cd();
+      return x;
+    }();
+    return h;
+  }
+  double jerWidth(int mode, double pt) {
+    TH1D * h = jerNominal();
+    if (mode == 1) {
+      const double w15 = h->Interpolate(15), s15 = (h->Interpolate(15.01) - h->Interpolate(14.99)) / 0.02;
+      return pt >= 15 ? h->Interpolate(pt) : w15 + s15*(pt - 15);
+    }
+    if (mode == 2) {
+      const double c1 = h->GetBinCenter(1), w5 = h->GetBinContent(1);
+      const double s5 = (h->GetBinContent(2) - h->GetBinContent(1)) / (h->GetBinCenter(2) - c1);
+      return pt >= c1 ? h->Interpolate(pt) : w5 + s5*(pt - c1);
+    }
+    return h->Interpolate(pt);
+  }
+  long nJerRef[3] = {0, 0, 0};    // R=0.4 jets, every event read: pt_calib < 5 (exact), truth-matched, pt_calib fallback
+  long nJerRefSel[3] = {0, 0, 0}; // the same for R=0.4 region-A in-situ pairs (first systag)
+  int jerRefKind[ana::nJetR];
+}
